# ---------------------------------------------------------------------------
# HAVREDESIGN - template do .env de PRODUCAO (B12)
# Copiar para .env e preencher. NUNCA versionar o .env preenchido.
#
# Diferencas face ao .env de desenvolvimento:
#   APP_DEBUG=false        -> nunca revela stack traces/segredos ao visitante
#   SESSION_SECURE_COOKIE  -> cookie de sessao so sai por HTTPS
#   LOG_LEVEL=warning      -> nao gravar debug em producao
#   BCRYPT_ROUNDS=12       -> custo de hashing por omissao do Laravel
#   ADMIN_PATH             -> caminho do painel (nao "admin")
# ---------------------------------------------------------------------------

APP_NAME=HAVREDESIGN
APP_ENV=production
# Gerar com: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://havredesign.ao

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=havre_design
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Obriga o cookie a so ser enviado por HTTPS (B12 - seguranca).
SESSION_SECURE_COOKIE=true

# B12.5 - caminho do painel de administração (config/admin.php).
# Nao usar "admin": escolha algo que nao apareca em wordlists. Valores com
# barra/vazios/que colidam com uma pagina publica voltam ao default "admin".
# Depois de alterar correr: php artisan optimize:clear
ADMIN_PATH=gestao-havre

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@havredesign.ao"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN="info@havredesign.ao"

# Palavra-passe do administrador usada pelo seeder (php artisan db:seed).
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# zoker/responsive-images — imagens responsivas (WebP)
# disk = disco com raiz em public/ (ver config/filesystems.php)
RESPONSIVE_IMAGES_DISK=web
RESPONSIVE_IMAGES_OUTPUT_DISK=web
RESPONSIVE_IMAGES_OUTPUT_PATH=responsive-images
# false = gerar as variantes no proprio pedido (exigir um worker: queue:work)
RESPONSIVE_IMAGES_QUEUE=false
