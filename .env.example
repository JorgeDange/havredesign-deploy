APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# B12 - obrigar cookies a HTTPS (ativar sempre que APP_URL for https://)
# SESSION_SECURE_COOKIE=true

# B12.5 - caminho do painel de administração (config/admin.php).
# Obscurece a URL de backoffice; em produção use algo não óbvio e não divulgado.
# Depois de alterar: php artisan optimize:clear (as rotas ficam em cache).
ADMIN_PATH=admin

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# zoker/responsive-images — imagens responsivas (WebP)
# disk = disco com raiz em public/ (ver config/filesystems.php)
RESPONSIVE_IMAGES_DISK=web
RESPONSIVE_IMAGES_OUTPUT_DISK=web
RESPONSIVE_IMAGES_OUTPUT_PATH=responsive-images
# false = gerar as variantes no proprio pedido (exigir um worker: queue:work)\nRESPONSIVE_IMAGES_QUEUE=false
